# --- Public (safe in the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase Edge Function secrets (set with `supabase secrets set`, NOT in Vercel/Netlify) ---
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically into Edge Functions.
CRON_SECRET=long-random-string
BRANDFETCH_CLIENT_ID=your-brandfetch-logo-client-id
BRANDFETCH_API_KEY=optional-brand-api-key
